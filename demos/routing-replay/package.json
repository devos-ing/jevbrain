{
  "name": "jev-routing-replay",
  "private": true,
  "type": "module",
  "scripts": {
    "extract": "bun scripts/extract.ts",
    "dev": "vite --host 127.0.0.1 --port 4430",
    "build": "bun run extract && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4430",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 1800000",
    "lint": "biome check ./src ./scripts ./test"
  },
  "dependencies": { "zod": "4.6.5" },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
